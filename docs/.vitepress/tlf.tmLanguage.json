{
    "name": "tlf",
    "displayName": "tlDR Function Description Language",
    "aliases": ["tldr_func"],
    "scopeName": "source.tlf",
    "fileTypes": ["tlf"],
    "patterns": [ 
        {
            "name": "function.user",
            "match": "\\w+(?=\\()"
        },
        {
            "name": "keyword.function.declaration",
            "match": "^function (?=\\w+\\()"
        },
        {
            "name": "keyword.function.return",
            "match": "(?<=->) ?[\\w_\\.]+"
        },
        {
            "name": "keyword.type",
            "match": "(?<=(:|OR)) ?[\\w\\.]+( OR)?"
        },

        {
            "name": "string",
            "begin": "\"",
            "end": "\""
        },

        {
            "name": "constant.language.gml",
            "match": "\\b(true|false|all|self|noone|undefined|NaN|infinity|global(?=\\.))"
        },
        {
            "name": "constant.numeric.gml",
            "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        },
        {
            "name": "constant.enum.gml",
            "match": "\\b[A-Z0-9_]+\\.[A-Z0-9_]+"
        },

        {
            "name": "asset.tldr",
            "match": "\\b(o|spr|font|mus|snd|room|tile|snd|shd)_\\w*"
        },
        {
            "scope": "variable.global",
            "settings": {
                "foreground": "#ff7eff"
            }
        },

        {
            "name": "comment.argdesc",
            "match": "(?<=-) .*"
        },

        {
            "name": "variable.builtin.gml",
            "match": "\\b(x|y|id|visible|solid|persistent|depth|layer|alarm|direction|speed|hspeed|vspeed|gravity|gravity_direction|friction|image_index|image_speed|image_number|image_angle|image_alpha|image_blend|image_xscale|image_yscale|sprite_index|mask_index|path_index|path_position|path_positionprev|path_speed|path_scale|path_orientation|path_endaction|timeline_index|timeline_position|timeline_speed|timeline_running|object_index|room|room_width|room_height|room_speed|fps|fps_real|current_time|current_year|current_month|current_day|current_weekday|current_hour|current_minute|current_second|score|lives|health)(?!\\w+)"
        },
        {
            "name": "variable.global",
            "match": "(?<=global\\.)\\w*"
        },
        {
            "name": "variable.instance",
            "match": "\\w+"
        }
    ]
}