{
  "name": "gml",
  "tokenColors": [
    {
      "scope": "comment", 
      "settings": { 
        "foreground": "#2b692b" 
      } 
    },
    {
      "scope": "jsdoc.directive",
      "settings": {
        "foreground": "#b871ff",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "jsdoc.type",
      "settings": {
        "foreground": "#727eff",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "jsdoc.name",
      "settings": {
        "foreground": "#72bfff",
        "fontStyle": "bold italic"
      }
    },

    { "scope": "string", 
      "settings": {
        "foreground": "#824400" 
      } 
    },
    { 
      "scope": "keyword", 
      "settings": {
         "foreground": "#660066",
         "fontStyle": "bold" 
        } 
    },
    { 
      "scope": "function", 
      "settings": {
         "foreground": "#660066" 
        } 
    },
    {
      "scope": ["constant", "asset"],
      "settings": {
        "foreground": "#Cf2040"
      }
    },
    {
      "scope": "variable.builtin",
      "settings": {
        "foreground": "#148016"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#005cc5"
      }
    },
    {
      "scope": "variable.global",
      "settings": {
        "foreground": "#105050"
      }
    },
    {
      "scope": "variable.local",
      "settings": {
        "foreground": "#006B6B"
      }
    }
  ]
}