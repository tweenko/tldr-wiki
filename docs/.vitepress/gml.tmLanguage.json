{
    "name": "gml",
    "displayName": "GameMaker Language",
    "aliases": ["gamemaker"],
    "scopeName": "source.gml",
    "fileTypes": ["gml"],
    "patterns": [  
        {
            "name": "jsdoc.directive",
            "match": "(?<=/// *)@\\w+"
        },
        {
            "name": "jsdoc.type",
            "match": "(?<=/// *@\\w+ )\\{[A-Za-z0-9_\\.\\,\\|]+\\}"
        },
        {
            "name": "jsdoc.name",
            "match": "(?<=/// *@\\w+ \\{[A-Za-z0-9_\\.\\,\\|]+\\} )\\w+"
        },
        {
            "name": "comment.line",
            "match": "//.*$"
        },
        {
            "name": "comment.block",
            "begin": "/\\*",
            "end": "\\*/"
        },

        {
            "name": "string.quoted.double.gml",
            "begin": "\"",
            "end": "\""
        },

        {
            "name": "keyword.control.gml",
            "match": "\\b(if|else|switch|case|default|for|while|do|until|repeat|with|break|continue|return|exit|delete)(?=( |\\(|;))"
        },
        {
            "name": "keyword.type.gml",
            "match": "\\b(var|globalvar|enum|function|constructor|new)"
        },
        {
            "name": "keyword.braces",
            "match": "(\\{|\\})"
        },
        {
            "name": "function.user",
            "match": "\\b[a-zA-Z_]\\w*(?=\\()"
        },
        {
            "name": "function.gml.room",
            "match": "\\b(room_[a-zA-Z_])\\w*(?=\\()"
        },
        {
            "name": "function.script.tldr.music",
            "match": "\\b(music_)\\w+"
        },

        {
            "name": "constant.language.gml",
            "match": "\\b(true|false|all|self|other|noone|undefined|NaN|infinity|global(?=\\.))"
        },
        {
            "name": "constant.numeric.gml",
            "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        },
        {
            "name": "constant.enum.user",
            "match": "\\b[A-Z0-9_]+\\.[A-Z0-9_]+"
        },
        {
            "name": "constant.enum.anime",
            "match": "\\banime_curve\\.\\w+"
        },

        {
            "name": "asset.tldr",
            "match": "\\b(o|spr|font|mus|snd|room|tile|snd|shd)_\\w*"
        },
        {
            "name": "variable.builtin.gml",
            "match": "\\b(x|y|id|visible|solid|persistent|depth|layer|alarm|direction|speed|hspeed|vspeed|gravity|gravity_direction|friction|image_index|image_speed|image_number|image_angle|image_alpha|image_blend|image_xscale|image_yscale|sprite_index|mask_index|path_index|path_position|path_positionprev|path_speed|path_scale|path_orientation|path_endaction|timeline_index|timeline_position|timeline_speed|timeline_running|object_index|room|room_width|room_height|room_speed|fps|fps_real|current_time|current_year|current_month|current_day|current_weekday|current_hour|current_minute|current_second|score|lives|health)"
        },
        {
            "name": "variable.global",
            "match": "(?<=global\\.)\\w*"
        },
        {
            "name": "variable.local", 
            "match": "(?<= *)_[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
            "name": "variable.instance",
            "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*"
        }
    ]
}
